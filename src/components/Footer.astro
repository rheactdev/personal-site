---
import Container from "@components/Container.astro";
import { SITE } from "@consts";
import BackToTop from "@components/BackToTop.astro";
---

<footer class="animate">
  <Container>
    <div class="relative">
      <div class="absolute right-0 -top-20">
        <BackToTop />
      </div>
    </div>
    <div class="flex justify-between items-center gap-3">
      <div>
        &copy; 2024 {`|`} {SITE.NAME}
      </div>
      <div class="join">
        <button id="light-theme-button" aria-label="Light theme" class="btn btn-ghost btn-circle btn-sm join-item">☀️</button>
        <button id="dark-theme-button" aria-label="Dark theme" class="btn btn-ghost btn-circle btn-sm join-item">🌙</button>
        <button id="system-theme-button" aria-label="System theme" class="btn btn-ghost btn-circle btn-sm join-item">💻</button>
      </div>
    </div>
  </Container>
</footer>
